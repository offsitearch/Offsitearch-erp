# ── Local Docker Dev ──────────────────────
# Copy this file to .env and fill in values.
# This file is for LOCAL development only.
# Production env vars are set on the deployment platform (Render / Vercel / Supabase).

# ── Local Postgres (docker compose `db` service) ──
# docker-compose.yml overrides DATABASE_URL automatically.
# Use localhost when running the backend directly on your machine (no Docker).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/offsite_erp

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=offsite_erp
POSTGRES_PORT=5432

# ── Backend ─────────────────────────────
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: REQUIRED — list your real deployed domain(s), comma-separated.
# The backend will refuse to start in production if this still contains localhost.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

ENVIRONMENT=development
DEBUG=true

# ── First Superadmin (created on startup if no users exist) ──
FIRST_SUPERUSER_EMAIL=admin@studioerp.dev
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Set to true to create sample data (employees, projects, invoices, etc.)
SEED_DEMO=false

# ── Supabase Storage (optional) ────────
# If set, files are stored in Supabase Storage instead of local disk.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key
# SUPABASE_BUCKET=studio-erp

# ── Email / SMTP (optional) ────────────
# Required for welcome emails, leave notifications, invoice delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=app-password-here
# EMAIL_FROM=noreply@studioerp.dev
# EMAIL_ENABLED=true
# Seconds before an SMTP connection attempt is aborted (default 30)
# SMTP_TIMEOUT_SECONDS=30

# Public base URL of the SPA — used for links inside emails and OAuth redirects.
# Must match the actual deployed URL of the frontend.
FRONTEND_URL=http://localhost:5173

# ── File storage ────────────────────────
# Seconds before a Supabase Storage / local-disk operation is aborted (default 30)
# STORAGE_TIMEOUT_SECONDS=30

# ── Frontend ────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=StudioERP

# ── Google Drive backup (Settings → Backup) ──
# Create an OAuth client in Google Cloud Console (see docs/GOOGLE_DRIVE_SETUP.md).
# The redirect URI must EXACTLY match one registered on the OAuth client.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Local dev:
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/backup/google/callback
# BACKUP_UI_REDIRECT=http://localhost:5173/settings?tab=backup

# ── Ports ───────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
